<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="800"
             x:Class="Store.LoginControl">
    <StackPanel Spacing="20" HorizontalAlignment="Center" VerticalAlignment="Center" Width="400">
        <TextBlock Text="Login" FontWeight="Bold" FontSize="30"/>
        
        <StackPanel>
            <TextBlock Text="Email"/>
            <TextBox PlaceholderText="exemple@gmail.com" x:Name="EmailInput"/>
        </StackPanel>
        
        <StackPanel>
            <TextBlock Text="Пароль"/>
            <TextBox PlaceholderText="******" PasswordChar="*" x:Name="PasswordInput"/>
        </StackPanel>
        
        <Button Content="Войти" Click="Login_OnClick"/>
        
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="5">
            <TextBlock Text="Ещё нет аккаунта?" 
                       VerticalAlignment="Center"/>
            
            <HyperlinkButton Content="Зарегистрироваться" 
                             VerticalAlignment="Center"
                             Click="ViewRegistration_OnClick"/>
        </StackPanel>
        
    </StackPanel>
</UserControl>
